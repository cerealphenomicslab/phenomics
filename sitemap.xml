---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign all = site.pages | concat: site.osoby -%}
{%- for p in all %}
{%- if p.lang and p.ref and p.ref != 'notfound' %}
  {%- assign alt = all | where: "ref", p.ref | where_exp: "x", "x.lang != p.lang" | first %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod>
    <xhtml:link rel="alternate" hreflang="{{ p.lang }}" href="{{ p.url | absolute_url }}"/>
    {%- if alt %}
    <xhtml:link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.url | absolute_url }}"/>
    {%- endif %}
  </url>
{%- endif %}
{%- endfor %}
</urlset>
